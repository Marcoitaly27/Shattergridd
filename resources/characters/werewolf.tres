[gd_resource type="Resource" load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/pieces/character_definition.gd" id="1_definition"]
[ext_resource type="PackedScene" path="res://scenes/pieces/characters/werewolf_human.tscn" id="2_model"]
[ext_resource type="Resource" path="res://resources/characters/forward_back_movement.tres" id="3_movement"]
[ext_resource type="Material" path="res://materials/ash_statue.tres" id="4_ash"]
[ext_resource type="Material" path="res://materials/slate_statue.tres" id="5_slate"]

[ext_resource type="Resource" path="res://resources/captures/warden.tres" id="6_capture"]
[ext_resource type="Resource" path="res://resources/abilities/wolf_blood_step.tres" id="7_ability"]

[ext_resource type="Resource" path="res://resources/audio/profiles/executioner.tres" id="8_audio"]

[ext_resource type="Resource" path="res://resources/characters/temporary_movement.tres" id="night_move"]
