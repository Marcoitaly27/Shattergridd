[resource]
resource_name = "Werewolf prototype"
script = ExtResource("1_definition")
character_id = &"werewolf"
title = "The Moonbound"
deployment_category = &"power"
gameplay_description = "Day: forward/backward. Night: all 8 directions. A night capture grants one exact 2-tile move in any direction on your next turn; clear path required."
unlocked_by_default = true
archetype_id = &"executioner"
display_name = "Werewolf"
lore_description = "A human stone figure whose other shape emerges with the night."
model_scene = ExtResource("2_model")
movement_behavior = ExtResource("3_movement")
team_materials = Array[Material]([ExtResource("4_ash"), ExtResource("5_slate")])
capture_behavior = ExtResource("6_capture")
post_capture_effect = ExtResource("7_ability")
audio_profile = ExtResource("8_audio")

night_movement_behavior = ExtResource("night_move")
night_model_scene = ExtResource("night_model")
night_capture_behavior = ExtResource("night_capture")
ability_description = "Blood Step: a night capture adds exact 2-tile moves in all 8 directions on your next turn. Clear path required; no extra action. Expires even if another ally acts."
